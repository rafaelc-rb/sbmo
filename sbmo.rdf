<?xml version="1.0"?>
<rdf:RDF xmlns="https://rafaelc-rb.github.io/sbmo"
     xml:base="https://rafaelc-rb.github.io/sbmo"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:sbmo="https://rafaelc-rb.github.io/sbmo#">
    <owl:Ontology rdf:about="https://rafaelc-rb.github.io/sbmo">
        <owl:versionIRI rdf:resource="https://rafaelc-rb.github.io/sbmo/1.0"/>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://rafaelc-rb.github.io/sbmo#exhibitsNetworkEffect -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#exhibitsNetworkEffect">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#EcosystemRole"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#NetworkEffectType"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#facesChallenge -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#facesChallenge">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#hasDeliveryMode -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#hasDeliveryMode">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#hasEcosystemRole -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#hasEcosystemRole">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#EcosystemRole"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#hasPricingStrategy -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#hasPricingStrategy">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#PricingStrategy"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#hasRevenueSource -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#hasRevenueSource">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#RevenueSource"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#hasSuccessFactor -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#hasSuccessFactor">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#SuccessFactor"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#mitigates -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#mitigates">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#MitigationStrategy"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#targetsCustomerType -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#targetsCustomerType">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#CustomerType"/>
    </owl:ObjectProperty>
    


    <!-- https://rafaelc-rb.github.io/sbmo#usesAcquisitionChannel -->

    <owl:ObjectProperty rdf:about="https://rafaelc-rb.github.io/sbmo#usesAcquisitionChannel">
        <rdfs:domain rdf:resource="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel"/>
        <rdfs:range rdf:resource="https://rafaelc-rb.github.io/sbmo#AcquisitionChannel"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://rafaelc-rb.github.io/sbmo#AcquisitionChannel -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#AcquisitionChannel">
        <rdfs:comment xml:lang="en">The channel through which a software business acquires customers. Includes direct sales, product-led growth, partner channels, digital marketing, and marketplaces.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#AdvertisingRevenue -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#AdvertisingRevenue">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#RevenueSource"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#B2B -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#B2B">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#CustomerType"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#B2C -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#B2C">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#CustomerType"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#CostBasedPricing -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#CostBasedPricing">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#PricingStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#CrossSidedNetworkEffect -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#CrossSidedNetworkEffect">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#NetworkEffectType"/>
        <owl:disjointWith rdf:resource="https://rafaelc-rb.github.io/sbmo#DataDrivenNetworkEffect"/>
        <owl:disjointWith rdf:resource="https://rafaelc-rb.github.io/sbmo#DirectNetworkEffect"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#CustomerTrustMaintenance -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#CustomerTrustMaintenance">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#CustomerType -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#CustomerType">
        <rdfs:comment xml:lang="en">The category of customer targeted by a software business model, classified by business relationship (B2B, B2C) or organization size (SME, Enterprise).</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#DataDrivenNetworkEffect -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#DataDrivenNetworkEffect">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#NetworkEffectType"/>
        <owl:disjointWith rdf:resource="https://rafaelc-rb.github.io/sbmo#DirectNetworkEffect"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#DeliveryMode -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#DeliveryMode">
        <rdfs:comment xml:lang="en">The technical mode through which software is delivered to end users. Includes multi-tenant SaaS, single-tenant SaaS, on-premises, mobile, desktop, and hybrid delivery.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#DesktopDelivery -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#DesktopDelivery">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#DigitalMarketing -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#DigitalMarketing">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#AcquisitionChannel"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#DirectNetworkEffect -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#DirectNetworkEffect">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#NetworkEffectType"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#DirectSales -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#DirectSales">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#AcquisitionChannel"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#EcosystemManagement -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#EcosystemManagement">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#SuccessFactor"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#EcosystemRole -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#EcosystemRole">
        <rdfs:comment xml:lang="en">The role a software company plays within its business ecosystem, such as standalone product provider, two-sided platform operator, or marketplace facilitator.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#Enterprise -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#Enterprise">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#CustomerType"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#FlexiblePricingStrategy -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#FlexiblePricingStrategy">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#MitigationStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#FreemiumPricing -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#FreemiumPricing">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#PricingStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#HybridDelivery -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#HybridDelivery">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#HybridModelAdoption -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#HybridModelAdoption">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#MitigationStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#ImplementationChallenge -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge">
        <rdfs:comment xml:lang="en">A challenge or barrier faced during the implementation or transition of a software business model.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#MarketExpansion -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#MarketExpansion">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#SuccessFactor"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#Marketplace -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#Marketplace">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#EcosystemRole"/>
        <owl:disjointWith rdf:resource="https://rafaelc-rb.github.io/sbmo#StandaloneProduct"/>
        <owl:disjointWith rdf:resource="https://rafaelc-rb.github.io/sbmo#TwoSidedPlatform"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#MarketplaceChannel -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#MarketplaceChannel">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#AcquisitionChannel"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#MitigationStrategy -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#MitigationStrategy">
        <rdfs:comment xml:lang="en">A practice or strategy used to address or reduce the impact of implementation challenges in software business models.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#MobileDelivery -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#MobileDelivery">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#MultiTenantSaaS -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#MultiTenantSaaS">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#NetworkEffectType -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#NetworkEffectType">
        <rdfs:comment xml:lang="en">The type of network effect exhibited by a software business model, where the value of the product increases with the number of users. Includes direct, cross-sided, and data-driven effects.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#OnPremises -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#OnPremises">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#OrganizationalPreparedness -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#OrganizationalPreparedness">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#SuccessFactor"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#OrganizationalReadiness -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#OrganizationalReadiness">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#PartnerChannel -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#PartnerChannel">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#AcquisitionChannel"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#PartnerCompensation -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#PartnerCompensation">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#MitigationStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#PartnerEcosystemDisruption -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#PartnerEcosystemDisruption">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#PayAsYouGoPricing -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#PayAsYouGoPricing">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#PricingStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#PerpetualLicenseRevenue -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#PerpetualLicenseRevenue">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#RevenueSource"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#PilotImplementation -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#PilotImplementation">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#MitigationStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#PricingStrategy -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#PricingStrategy">
        <rdfs:comment xml:lang="en">The approach used to determine and structure the price of a software offering. Includes subscription-based, pay-as-you-go, value-based, cost-based, and freemium strategies.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#ProductLedGrowth -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#ProductLedGrowth">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#AcquisitionChannel"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#QualityManagement -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#QualityManagement">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#RevenueSource -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#RevenueSource">
        <rdfs:comment xml:lang="en">The mechanism through which a software business generates income. Identified sources include subscription, usage/consumption, transaction, advertising, and perpetual licensing.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#RevenueStreamTransformation -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#RevenueStreamTransformation">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#SME -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#SME">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#CustomerType"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#SecurityConcerns -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#SecurityConcerns">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#ImplementationChallenge"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#ServiceQualityImprovement -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#ServiceQualityImprovement">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#SuccessFactor"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#SingleTenantSaaS -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#SingleTenantSaaS">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#SoftwareBusinessModel">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rafaelc-rb.github.io/sbmo#hasDeliveryMode"/>
                <owl:someValuesFrom rdf:resource="https://rafaelc-rb.github.io/sbmo#DeliveryMode"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rafaelc-rb.github.io/sbmo#hasEcosystemRole"/>
                <owl:someValuesFrom rdf:resource="https://rafaelc-rb.github.io/sbmo#EcosystemRole"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://rafaelc-rb.github.io/sbmo#hasRevenueSource"/>
                <owl:someValuesFrom rdf:resource="https://rafaelc-rb.github.io/sbmo#RevenueSource"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">A business model applied to software-intensive offerings, describing how value is created, delivered, and captured through software products, platforms, or services.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#StandaloneProduct -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#StandaloneProduct">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#EcosystemRole"/>
        <owl:disjointWith rdf:resource="https://rafaelc-rb.github.io/sbmo#TwoSidedPlatform"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#SubscriptionBasedPricing -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#SubscriptionBasedPricing">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#PricingStrategy"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#SubscriptionRevenue -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#SubscriptionRevenue">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#RevenueSource"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#SuccessFactor -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#SuccessFactor">
        <rdfs:comment xml:lang="en">A factor that contributes to the successful implementation and operation of a software business model.</rdfs:comment>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#TransactionRevenue -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#TransactionRevenue">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#RevenueSource"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#TwoSidedPlatform -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#TwoSidedPlatform">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#EcosystemRole"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#UsageConsumptionRevenue -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#UsageConsumptionRevenue">
        <rdfs:subClassOf rdf:resource="https://rafaelc-rb.github.io/sbmo#RevenueSource"/>
    </owl:Class>
    


    <!-- https://rafaelc-rb.github.io/sbmo#ValueBasedOrientation -->

    <owl:Class rdf:about="https://rafaelc-rb.github.io/sbmo#ValueBasedOrientation">
